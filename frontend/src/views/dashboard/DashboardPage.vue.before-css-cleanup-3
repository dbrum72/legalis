/* Seções */

.dashboard-attention,
.dashboard-my-work,
.dashboard-activity,
.dashboard-recent {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.dashboard-section-header{
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-4);
}

.dashboard-section-header--compact {
  margin-bottom: calc(var(--space-2) * -1);
}

.dashboard-section-title {
  margin: 0;

  color: var(--color-text);

  font-size: 1.2rem;
  font-weight: 750;
}

.dashboard-section-title--small {
  font-size: 1rem;
}

/* Prioridades */

.dashboard-priorities-layout {
  display: grid;

  grid-template-columns:
    minmax(0, 1.35fr) minmax(19rem, 0.9fr);

  gap: var(--space-4);
}

.dashboard-legal-alerts {
  display: grid;

  grid-template-columns:
    repeat(2,
      minmax(0, 1fr));

  gap: var(--space-4);
}

.dashboard-today-agenda {
  min-width: 0;
}

.dashboard-attention-card {
  position: relative;

  min-height: 100%;

  overflow: hidden;
}

.dashboard-attention-card::before {
  position: absolute;

  top: 0;
  bottom: 0;
  left: 0;

  width: 4px;

  content: '';
}

.dashboard-attention-card--critical::before {
  background: var(--color-danger);
}

.dashboard-attention-card--today::before {
  background: var(--color-warning);
}

.dashboard-agenda-card {
  height: 100%;
}

.dashboard-attention-content {
  display: flex;
  height: 100%;
  flex-direction: column;
  gap: var(--space-3);
}

.dashboard-attention-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-3);
}

.dashboard-attention-title-group {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: var(--space-2);
}

.dashboard-attention-label {
  color: var(--color-text);

  font-size: var(--font-size-sm);
  font-weight: 750;
}

.dashboard-attention-value {
  color: var(--color-text);

  font-size: 2rem;
  font-weight: 750;

  line-height: 1;
}

.dashboard-attention-card--critical .dashboard-attention-value {
  color: var(--color-danger);
}

.dashboard-attention-card--today .dashboard-attention-value {
  color: var(--color-warning);
}

.dashboard-attention-indicator {
  width: 0.6rem;
  height: 0.6rem;

  flex: 0 0 auto;

  margin-top: 0.25rem;

  border-radius: 999px;
}

.dashboard-attention-indicator--critical {
  background: var(--color-danger);
}

.dashboard-attention-indicator--today {
  background: var(--color-warning);
}

.dashboard-attention-description {
  color: var(--color-text-muted);

  font-size: var(--font-size-sm);

  line-height: 1.45;
}

.dashboard-attention-list {
  display: flex;
  flex: 1;
  flex-direction: column;

  margin-top: var(--space-1);

  border-top: 1px solid var(--color-border);
}

.dashboard-attention-item {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);

  padding: var(--space-3) 0;

  border-bottom: 1px solid var(--color-border);
}

.dashboard-attention-item:last-child {
  border-bottom: 0;
}

.dashboard-attention-item-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-2);
}

.dashboard-attention-item-title {
  min-width: 0;

  color: var(--color-text);

  font-size: var(--font-size-sm);
  font-weight: 650;

  line-height: 1.4;
}

.dashboard-attention-item-meta {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);

  color: var(--color-text-muted);

  font-size: var(--font-size-sm);

  line-height: 1.4;
}

.dashboard-attention-empty {
  display: flex;

  min-height: 5rem;

  align-items: center;
  justify-content: center;

  padding: var(--space-4) 0;

  color: var(--color-text-muted);

  font-size: var(--font-size-sm);

  text-align: center;
}

/* Agenda */



.dashboard-agenda-body {
  position: relative;

  display: flex;
  flex-direction: column;
  gap: var(--space-2);

  padding-left: var(--space-3);
}

.dashboard-agenda-body::before {
  position: absolute;

  top: 0.25rem;
  bottom: -1rem;
  left: 0;

  width: 1px;

  background:
    color-mix(in srgb,
      var(--color-warning) 35%,
      var(--color-border));

  content: '';
}

.dashboard-agenda-body::after {
  position: absolute;

  top: 0.2rem;
  left: -0.23rem;

  width: 0.5rem;
  height: 0.5rem;

  border-radius: 999px;

  background: var(--color-warning);

  content: '';
}

/* Listas */

.dashboard-my-work-grid {
  display: grid;

  grid-template-columns:
    repeat(3,
      minmax(0, 1fr));

  gap: var(--space-4);
}

.dashboard-list-card {
  height: 100%;
}

.dashboard-list-card--personal {
  position: relative;

  overflow: hidden;
}

.dashboard-list-card--personal::before {
  position: absolute;

  top: 0;
  right: 0;
  left: 0;

  height: 3px;

  background:
    linear-gradient(90deg,
      var(--color-primary),
      var(--color-warning));

  content: '';
}








.dashboard-item-badge {
  display: inline-flex;

  min-height: 1.5rem;

  flex: 0 0 auto;
  align-items: center;

  padding: 0 var(--space-2);

  border-radius: 999px;

  background: var(--color-surface-muted);

  color: var(--color-text-muted);

  font-size: var(--font-size-sm);
  font-weight: 650;
}

.dashboard-item-badge--high {
  color: var(--color-danger);
}

.dashboard-item-badge--medium {
  color: var(--color-warning);
}

.dashboard-item-badge--low {
  color: var(--color-success);
}





.dashboard-item-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: var(--space-2);

  margin-top: var(--space-1);
}

/* Links */

.dashboard-folder-link {
  display: flex;

  width: 100%;

  align-items: flex-start;
  flex-direction: column;
  gap: var(--space-1);

  padding: 0;

  border: 0;

  background: transparent;

  color: var(--color-primary);

  cursor: pointer;

  font: inherit;

  text-align: left;
}

.dashboard-folder-link:hover {
  text-decoration: underline;
}

.dashboard-folder-link:focus-visible {
  outline: 2px solid var(--color-primary);
  outline-offset: 3px;

  border-radius: var(--radius-sm);
}

.dashboard-folder-link-process {
  color: var(--color-text-muted);

  font-size: var(--font-size-sm);
}

/* Movimento do escritório */

.dashboard-secondary {
  min-width: 0;
}

.dashboard-office-movement {
  display: grid;

  grid-template-columns:
    minmax(0, 1.15fr) minmax(18rem, 0.85fr);

  gap: var(--space-4);
}




/* Pastas recentes */











