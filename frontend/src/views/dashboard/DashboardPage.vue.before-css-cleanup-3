  line-height: 1;
}

.dashboard-stat-card__trend-icon {
  font-size: 1.15rem;
  font-weight: 500;

  line-height: 0.8;
}

.dashboard-stat-card__neutral-icon {
  display: inline-grid;

  width: 16px;
